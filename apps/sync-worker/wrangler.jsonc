{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cairn-sync-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cairn-sync",
      "database_id": "e48532e5-5a8f-4e27-8334-1bf341e49856"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BOOKS",
      "bucket_name": "cairn-book-resources"
    }
  ]
}
