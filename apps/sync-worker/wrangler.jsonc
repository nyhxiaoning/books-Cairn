{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cairn-sync-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cairn-sync",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BOOKS",
      "bucket_name": "cairn-book-resources"
    }
  ]
}
